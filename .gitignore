# ============================================================
#  仓库分层策略（2026-10-05）
#
#  设计目标：仓库只承载「文档 + 前端外壳」，
#  密钥材料、解密引擎、逆向脚本一律不入库。
#
#  改动前请用 git add -n 确认拟入库文件中
#  不含任何 64 位 hex 密钥与 engine/ 路径。
# ============================================================

# ---- 截图 / 中间交付物 ----
deliverables/

# ---- 本地笔记 ----
.workbuddy/

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Python 通用 ----
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ============================================================
#  wememo_app：只推前端外壳，解密引擎整体排除
# ============================================================

# 引擎侧全部内容（decryptor/keyextract/wcdb/imgdecrypt/pyaes_fallback，
# 以及 _verify_tmp/_bench_tmp 下 608MB 解密明文 .db）
wememo_app/engine/

# 构建产物与工具链（约 1.8G）
wememo_app/node_modules/
wememo_app/.toolchain/
wememo_app/release/
wememo_app/runtime/
wememo_app/dist/
wememo_app/out/
wememo_app/build/
wememo_app/.venv/
wememo_app/__pycache__/

# ============================================================
#  archive/：只推文档
#  逆向脚本与密钥材料整体排除。
#  （原「archive/ 整目录屏蔽」已废除——它反而让密钥文件
#    连被单独排除的机会都没有，改为按类型精确屏蔽）
# ============================================================

# 全部 Python 逆向脚本（含硬编码主密钥 61 处）
archive/**/*.py

# WeFlow 官方打包产物（第三方代码，仅作逆向参考）
# 虽无密钥命中，但属他方产物，本仓库只保留我方文档
archive/weflow_extract/

# 签名特征库之外的二进制归档
*.tgz

# 密钥与凭据材料（按 basename 匹配，覆盖任意层级）
master_key.txt
all_keys.txt
captured_keys.txt
key.txt
*_keys.txt
latest_keyinfo.json
derived_keys.json
key_info.plain
weflow_key.txt
aes_keys_startup.txt

# 数据库与解密产物
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.plain
keyinfo_backup/

# 根目录遗留的密钥文件
06_inject/master_key.txt